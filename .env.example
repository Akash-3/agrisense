# AgriSense Environment Configuration
# Copy this file to .env and set your API keys for Generative AI support.

# Primary Generative AI Provider (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Alternative Generative AI Provider (OpenAI API)
OPENAI_API_KEY=your_openai_api_key_here

# Database Path (Optional override)
DB_PATH=app/backend/agrisense_farmer.db
